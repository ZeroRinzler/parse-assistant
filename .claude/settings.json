{
    "permissions": {
        "allow": [
            "Bash(claude mcp *)",
            "Skill(run)",
            "Bash",
            "Read",
            "Edit",
            "Write",
            "WebFetch",
            "WebSearch",
            "NotebookEdit",
            "Agent"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": ". /opt/nvm/nvm.sh && nvm install 24 --no-progress && ln -sf \"$(nvm which 24)\" /opt/node22/bin/node"
                    }
                ]
            }
        ]
    }
}
