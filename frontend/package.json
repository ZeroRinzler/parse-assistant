{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test && vitest run --config vitest.scripts.config.ts && tsc -p tsconfig.scripts.json --noEmit",
    "test:ci": "ng test --configuration ci && vitest run --config vitest.scripts.config.ts && tsc -p tsconfig.scripts.json --noEmit",
    "test:watch": "ng test --watch",
    "rulebook": "tsx --tsconfig tsconfig.scripts.json scripts/build-rulebook.ts",
    "ingest": "tsx --tsconfig tsconfig.scripts.json scripts/ingest-parses.ts",
    "scrape": "tsx --tsconfig tsconfig.scripts.json scripts/scrape-guides.ts"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/animations": "^22.0.1",
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.1",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@apollo/client": "^4.2.3",
    "@tailwindcss/postcss": "^4.3.1",
    "apollo-angular": "^14.1.0",
    "chart.js": "^4.4.0",
    "postcss": "^8.5.15",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.0.1",
    "ajv": "^8.20.0",
    "commander": "^13.1.0",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "jsdom": "^25.0.1",
    "p-limit": "^7.3.0",
    "prettier": "^3.8.1",
    "sass": "^1.99.0",
    "simple-statistics": "^7.9.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
