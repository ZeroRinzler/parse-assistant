{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --configuration ci",
    "ingest": "node scripts/ingest-headless.mjs",
    "e2e": "playwright test",
    "lint": "ng lint && eslint scripts e2e playwright.config.ts",
    "knip": "knip",
    "data:pull": "git -C .. fetch origin gh-pages && rm -rf public/data/specs && git -C .. archive origin/gh-pages data/specs | tar -x -C public",
    "schema:pull": "node scripts/schema-pull.mjs"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/material": "^22.1.2",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@noble/hashes": "^2.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "d3-array": "^3.2.4",
    "mediabunny": "^1.53.1",
    "ng-http-caching": "^22.1.0",
    "p-limit": "^7.3.1",
    "postcss": "^8.5.15",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/core": "^6.2.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@graphql-tools/graphql-tag-pluck": "^8.3.36",
    "@playwright/test": "^1.62.1",
    "@types/d3-array": "^3.2.2",
    "angular-eslint": "22.1.0",
    "cors": "^2.8.6",
    "eslint": "^10.8.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "graphql": "^17.0.2",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "playwright": "^1.61.1",
    "sass": "^1.102.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.1.10",
    "write-file-atomic": "^8.0.0"
  },
  "type": "module"
}
