# Environment - never commit secrets
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/
ENV/

# Data - all persistent data is file-based under data/specs/ (no SQLite)
data/*.db
data/*.log
data/tmp/

# Generated bench data lives on the always-squashed `gh-pages` branch, not main.
# It is fetched into the working tree for local dev via `npm run data:pull`
# (from frontend/). Never tracked on main - the history there would grow without
# bound. See CLAUDE.md and the ingest/deploy workflows.
frontend/public/data/specs/

# Logs
*.log
logs/

static/angular/
node_modules/

# Editor / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
frontend/playwright.local.config.ts
